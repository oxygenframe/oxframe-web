{
  "name": "@oxframe/editor-ui",
  "version": "0.1.7",
  "type": "module",
  "description": "The oxframe editor: viewport, timeline, inspector, curve editor. Svelte library + standalone bundle served by oxframe-cli.",
  "svelte": "./src/lib/index.ts",
  "exports": {
    ".": {
      "svelte": "./src/lib/index.ts",
      "default": "./src/lib/index.ts"
    },
    "./styles.css": "./src/lib/styles/theme.css"
  },
  "scripts": {
    "dev": "vite",
    "build:standalone": "vite build && bun scripts/manifest.ts",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "vitest run",
    "e2e": "playwright test",
    "size": "bun scripts/size.ts"
  },
  "dependencies": {
    "@oxframe/backends": "workspace:*",
    "@oxframe/protocol": "workspace:*"
  },
  "peerDependencies": {
    "svelte": "^5.40.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "svelte": "5.57.2",
    "svelte-check": "4.7.7",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "3.2.7",
    "jsdom": "27.2.0"
  },
  "license": "MIT"
}
