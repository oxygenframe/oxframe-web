{
  "name": "oxframe-web",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "build": "bun run --cwd packages/editor-ui build:standalone && bun run --cwd apps/site build",
    "build:editor": "bun run --cwd packages/editor-ui build:standalone",
    "check": "bun run --cwd packages/editor-ui check && bun run --cwd apps/site check && tsc -p services/compile --noEmit && tsc -p packages/backends --noEmit",
    "test": "bun run --cwd packages/backends test && bun run --cwd packages/editor-ui test && bun test --cwd services/compile",
    "e2e": "bun run --cwd packages/editor-ui e2e",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "sync-protocol": "bun scripts/sync-protocol.ts",
    "sync-examples": "bun scripts/sync-examples.ts",
    "dev:site": "bun run --cwd apps/site dev",
    "dev:compile": "RUNNER=local bun --cwd services/compile src/index.ts"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "eslint-plugin-svelte": "3.23.1",
    "globals": "16.5.0",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "3.5.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "@types/bun": "1.4.3"
  }
}
