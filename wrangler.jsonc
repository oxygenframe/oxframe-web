// oxframe.dev on Cloudflare Workers: static assets, plus a small Worker for
// /media/* (rendered videos from the R2 bucket, apps/site/worker/index.ts).
// Only the site is deployed here; the compile service is its own Worker
// (services/compile-cf, compile.oxframe.dev, deployed by GitHub Actions).
// www.oxframe.dev → oxframe.dev is a 301 Redirect Rule in the zone (the
// pages also carry canonical URLs).
//
// Workers Builds (git integration) works with the defaults: root directory
// "/", build command `bun run build`, deploy command `npx wrangler deploy`,
// plus the build variable PUBLIC_COMPILE_URL=https://compile.oxframe.dev.
// By hand: PUBLIC_COMPILE_URL=https://compile.oxframe.dev bun run deploy
//
// The site build also writes apps/site/build/_headers (security headers and
// the engine worker's CSP, see apps/site/scripts/cf-headers.ts).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "oxframe-site",
  "compatibility_date": "2026-10-01",
  "main": "./apps/site/worker/index.ts",
  "assets": {
    "directory": "./apps/site/build",
    "binding": "ASSETS",
    // Only media and shares reach the Worker; every other path is a static file.
    "run_worker_first": ["/media/*", "/api/*", "/s/*"],
    // adapter-static writes docs/cli.html; serve it at /docs/cli.
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
  },
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "oxframe" }],
  // Shared playground videos: a few uploads a minute per address.
  "ratelimits": [
    { "name": "SHARE_LIMIT", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } },
  ],
  "routes": [
    { "pattern": "oxframe.dev", "custom_domain": true },
    { "pattern": "www.oxframe.dev", "custom_domain": true },
  ],
  // Preview builds of branches: the same bucket (their shares go under
  // previews/, see worker/index.ts) and their own rate-limit counter.
  "previews": {
    "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "oxframe" }],
    "ratelimits": [
      { "name": "SHARE_LIMIT", "namespace_id": "1002", "simple": { "limit": 3, "period": 60 } },
    ],
  },
  "workers_dev": true,
  "preview_urls": true,
  "observability": { "enabled": true },
}
