// oxframe.dev on Cloudflare Workers (static assets only, no Worker code).
//
//   PUBLIC_COMPILE_URL=https://compile.oxframe.dev bun run deploy
//
// The compile-service (cargo + Docker/gVisor) cannot run on Cloudflare; it
// lives on its own host and must list https://oxframe.dev in CORS_ORIGINS.
// Security headers come from build/_headers, generated by
// scripts/cf-headers.ts from the same PUBLIC_COMPILE_URL (see serve.ts for
// the local equivalent).
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "oxframe-site",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./build",
    // adapter-static writes docs/cli.html; serve it at /docs/cli.
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
  },
  "routes": [
    { "pattern": "oxframe.dev", "custom_domain": true },
    { "pattern": "www.oxframe.dev", "custom_domain": true },
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": { "enabled": true },
}
