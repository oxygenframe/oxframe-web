{
  "name": "@oxframe/site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "bun serve.ts",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "e2e": "playwright test",
    "deploy": "vite build && bun scripts/cf-headers.ts && wrangler deploy",
    "deploy:preview": "vite build && bun scripts/cf-headers.ts && wrangler versions upload"
  },
  "dependencies": {
    "@oxframe/backends": "workspace:*",
    "@oxframe/editor-ui": "workspace:*",
    "@oxframe/protocol": "workspace:*",
    "lz-string": "1.5.0",
    "monaco-editor": "0.52.2"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "svelte": "5.57.2",
    "svelte-check": "4.7.7",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "wrangler": "4.147.0"
  }
}
