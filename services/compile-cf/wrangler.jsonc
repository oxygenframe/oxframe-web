// compile.oxframe.dev: Worker + R2 cache + build containers.
//
// Deployed by .github/workflows/deploy-compile.yml: it builds the Dockerfile
// on GitHub (no time limit, layer cache), pushes it to the Cloudflare
// registry and deploys with scripts/deploy-config.ts, which points `image`
// at that registry tag. Deploying from a machine with Docker:
// `bun run deploy` (builds the Dockerfile itself).
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "oxframe-compile",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "vars": {
    "CORS_ORIGINS": "https://oxframe.dev,https://www.oxframe.dev",
    "POOL_SIZE": "1",
  },
  "r2_buckets": [{ "binding": "ARTIFACTS", "bucket_name": "oxframe" }],
  // Builds per client IP (cache hits are not limited).
  "ratelimits": [
    { "name": "LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
  ],
  "durable_objects": { "bindings": [{ "name": "BUILDER", "class_name": "Builder" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Builder"] }],
  "containers": [
    {
      "class_name": "Builder",
      "image": "./Dockerfile",
      "image_build_context": "../..",
      // 4 vCPU / 12 GiB / 20 GB disk: the toolchain and a warm SDK build.
      "instance_type": "standard-3",
      "max_instances": 2,
    },
  ],
  // Prebuild examples that are not in R2 yet (after every deploy).
  "triggers": { "crons": ["*/30 * * * *"] },
  "routes": [{ "pattern": "compile.oxframe.dev", "custom_domain": true }],
  "observability": { "enabled": true },
}
